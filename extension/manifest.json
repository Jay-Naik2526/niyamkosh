{
  "manifest_version": 3,
  "name": "NiyamKosh — Standards Check",
  "version": "0.4",
  "description": "Checks Indian Standards cited on a procurement page against the BIS register, the certification rules and the co-citation graph.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }, "default_title": "Check standards on this page" },
  "content_scripts": [
    {
      "matches": ["https://*.gem.gov.in/*", "https://*.eprocure.gov.in/*", "https://*.nprocure.com/*", "http://localhost/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["icons/icon32.png"], "matches": ["<all_urls>"] }]
}
